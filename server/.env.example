# Connection to an OpenAI-compatible LLM (LM Studio, Ollama's OpenAI-compatible
# endpoint, vLLM, llama.cpp server, etc.)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=not-needed
LLM_MODEL_ID=qwen3:4b

# Server settings
PORT=3001
DB_PATH=./data/chat.sqlite

# Comma-less single origin allowed to call the API (use * only for local dev)
CORS_ORIGIN=http://localhost:5173

# Мок-ответ: сервер стримит фиксированный markdown из
# server/src/services/mockMarkdown.md вместо обращения к LLM.
# Включён по умолчанию; MOCK_RESPONSE=off возвращает обычную работу с моделью.
MOCK_RESPONSE=on

# Путь к markdown-файлу с мок-ответом. Относительные пути считаются от папки
# server. Если не задан — берётся mockMarkdown.md рядом с кодом сервиса
# (в dev это src/services/, в сборке dist/services/).
# Варианты: mockMarkdown.md — полный перебор синтаксиса (проверка рендерера),
# mockMarkdownDemo.md — демонстрация внешнего вида для дизайнера,
# mockMarkdownVideos.md — все варианты ссылок на видео и крайние случаи.
MOCK_RESPONSE_PATH=./src/services/mockMarkdown.md
